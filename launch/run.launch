<launch>

    <arg name="user_freq" default="0.5" />
    <param name="freq" type="double" value="$(arg user_freq)" />

    <arg name="user_state" default="manual" />
    <param name="current_state" type="str" value="$(arg user_state)" />

    <node name = "controleur" pkg = "projet_robotic" type = "controleur" output = "screen" />

    <node name = "key_input_node" pkg = "projet_robotic" type = "key_input_node" output = "screen" />

</launch>
